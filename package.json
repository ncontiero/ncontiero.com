{
  "name": "ncontiero.com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "description": "Bridge to my projects.",
  "author": "Nicolas Contiero <https://github.com/ncontiero>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others --names \"contentlayer,next\" -c \"magenta,black\" \"contentlayer2 dev\" \"next dev\"",
    "build": "contentlayer2 build && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "check:spell": "cspell",
    "check:case": "case-police src/data/**/*.{ts,tsx,md,mdx,json} src/i18n/**/*.{ts,tsx,md,mdx,json}",
    "check": "pnpm lint && pnpm typecheck && pnpm check:spell && pnpm check:case",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "pre-commit": "lint-staged",
    "postinstall": "next typegen"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "contentlayer2": "0.5.8",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "next-contentlayer2": "0.5.8",
    "next-intl": "4.13.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-toastify": "11.1.0",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@cspell/dict-pt-br": "2.4.2",
    "@ncontiero/eslint-config": "8.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "25.9.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "case-police": "2.2.1",
    "concurrently": "10.0.3",
    "cspell": "10.0.1",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss": "8.5.19",
    "rehype-pretty-code": "0.14.4",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
